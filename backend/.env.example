# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-side secret used by the backend to read/write notes (bypasses Row Level
# Security). Never expose this to the frontend or commit it. The anon key above is
# only used for the /auth/register and /auth/login proxy calls to Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Google Gemini API (for RAG /chat feature)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# pgvector embedding dimensions (must match backend/sql/schema.sql)
EMBEDDING_DIMENSIONS=768

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed Vercel URL here in production, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
